---
/**
 * The site's wordmark, in the header of every page.
 *
 * Until now the title existed only as the home page's <h1>, so anyone
 * arriving on an essay from a search result saw four nav links and no
 * indication of whose site it was.
 *
 * The mark is a link home everywhere except the home page itself,
 * where it is plain text — a link to the page you are on is noise.
 */

import site from '../data/site.json';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const [first, ...rest] = site.title.split(' ');
---

{
  home ? (
    <span class="mark" aria-current="page">
      <span class="first">{first}</span> {rest.join(' ')}
    </span>
  ) : (
    <a class="mark" href={`${base}/`}>
      <span class="first">{first}</span> {rest.join(' ')}
    </a>
  )
}

<style>
  .mark {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  /* "Moving" takes the accent; "Parts" stays in ink. A small thing,
     but it makes the mark read as a mark rather than a heading. */
  .first {
    color: var(--accent);
  }

  a.mark:hover .first {
    color: var(--text);
  }

  a.mark:hover {
    color: var(--accent);
  }
</style>
