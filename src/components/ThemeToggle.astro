---
/**
 * Theme toggle: light ⇄ dark.
 *
 * Auto is the default — a visitor who never touches this keeps their
 * system setting for good. Tapping sets an explicit override, and the
 * footer then offers a visible way back rather than a hidden gesture.
 */
---

<button id="theme-toggle" type="button">
  <span class="icon" aria-hidden="true">
    <!-- Sun: filled disc with filled rays, so the colour actually reads. -->
    <svg viewBox="0 0 24 24" width="17" height="17" data-icon="light">
      <circle cx="12" cy="12" r="5" fill="currentColor" />
      <g fill="currentColor">
        <rect x="11.1" y="1.4" width="1.8" height="4" rx="0.9" />
        <rect x="11.1" y="18.6" width="1.8" height="4" rx="0.9" />
        <rect x="1.4" y="11.1" width="4" height="1.8" rx="0.9" />
        <rect x="18.6" y="11.1" width="4" height="1.8" rx="0.9" />
        <rect x="11.1" y="1.4" width="1.8" height="4" rx="0.9"
              transform="rotate(45 12 12)" />
        <rect x="11.1" y="18.6" width="1.8" height="4" rx="0.9"
              transform="rotate(45 12 12)" />
        <rect x="1.4" y="11.1" width="4" height="1.8" rx="0.9"
              transform="rotate(45 12 12)" />
        <rect x="18.6" y="11.1" width="4" height="1.8" rx="0.9"
              transform="rotate(45 12 12)" />
      </g>
    </svg>

    <!-- Moon: a filled crescent, for the same reason. -->
    <svg viewBox="0 0 24 24" width="17" height="17" data-icon="dark">
      <path
        d="M21 14.1A8.6 8.6 0 1 1 9.9 3a6.8 6.8 0 0 0 11.1 11.1Z"
        fill="currentColor"
      />
    </svg>
  </span>
</button>

<style>
  button {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: border-color 0.14s;
  }

  button:hover {
    border-color: var(--accent);
  }

  .icon {
    display: grid;
    place-items: center;
    inline-size: 17px;
    block-size: 17px;
  }

  .icon svg {
    grid-area: 1 / 1;
    display: none;
  }

  [data-icon='light'] {
    display: block;
    color: var(--sun);
  }

  [data-icon='dark'] {
    color: var(--moon);
  }

  :global(:root[data-theme='dark']) [data-icon='light'] { display: none; }
  :global(:root[data-theme='dark']) [data-icon='dark'] { display: block; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) [data-icon='light'] { display: none; }
    :global(:root:not([data-theme='light'])) [data-icon='dark'] { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const stored = () => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : null;
      } catch {
        return null;
      }
    };

    /** What is rendered right now, stored choice or OS. */
    const active = () => stored() ?? (media.matches ? 'dark' : 'light');

    /** The footer offer appears only once an override is in force. */
    const refresh = () => {
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        const to = active() === 'dark' ? 'light' : 'dark';
        btn.setAttribute('aria-label', `Switch to ${to} mode`);
        btn.title = `Switch to ${to} mode`;
      }
      const reset = document.getElementById('theme-reset');
      if (reset) reset.hidden = !stored();
    };

    refresh();

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = active() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {}
      root.setAttribute('data-theme', next);
      refresh();
    });

    document.getElementById('theme-reset')?.addEventListener('click', () => {
      try {
        localStorage.removeItem('theme');
      } catch {}
      root.removeAttribute('data-theme');
      refresh();
    });

    media.addEventListener('change', refresh);
    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') refresh();
    });
  })();
</script>
