---
/**
 * Theme toggle: light ⇄ dark on tap.
 *
 * Two states, because a three-state cycle makes a mistaken tap cost two
 * more to undo. Auto is still reachable — press and hold, or double
 * click, to clear the stored choice and follow the OS again. That is
 * mentioned in the tooltip rather than shown, since almost nobody
 * needs it and the default is Auto anyway.
 */
---

<button id="theme-toggle" type="button">
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
         stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
         data-icon="light">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.1M12 19.3v2.1M4.3 4.3l1.5 1.5M18.2 18.2l1.5 1.5M2.6 12h2.1M19.3 12h2.1M4.3 19.7l1.5-1.5M18.2 5.8l1.5-1.5" />
    </svg>

    <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
         stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
         stroke-linejoin="round" data-icon="dark">
      <path d="M20.5 14.2A8.4 8.4 0 1 1 9.8 3.5a6.6 6.6 0 0 0 10.7 10.7Z" />
    </svg>
  </span>
</button>

<style>
  button {
    display: inline-grid;
    place-items: center;
    /* 44px, the usual minimum for a comfortable tap. */
    inline-size: 2.75rem;
    block-size: 2.75rem;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.14s, border-color 0.14s;
  }

  button:hover {
    border-color: var(--accent);
  }

  .icon {
    display: grid;
    place-items: center;
    inline-size: 16px;
    block-size: 16px;
  }

  /* Both glyphs share a cell; the active theme picks which shows. */
  .icon svg {
    grid-area: 1 / 1;
    display: none;
  }

  /* Light in force: a warm sun. */
  [data-icon='light'] {
    display: block;
    color: var(--sun);
  }

  [data-icon='dark'] {
    color: var(--moon);
  }

  :global(:root[data-theme='dark']) [data-icon='light'] { display: none; }
  :global(:root[data-theme='dark']) [data-icon='dark'] { display: block; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) [data-icon='light'] { display: none; }
    :global(:root:not([data-theme='light'])) [data-icon='dark'] { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const stored = () => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : null;
      } catch {
        return null;
      }
    };

    /** What is actually rendered right now. */
    const active = () => stored() ?? (media.matches ? 'dark' : 'light');

    const describe = () => {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      const to = active() === 'dark' ? 'light' : 'dark';
      const label = `Switch to ${to} mode`;
      btn.setAttribute('aria-label', label);
      btn.title = stored()
        ? `${label} (hold to follow system)`
        : `${label} (currently following system)`;
    };

    const set = (choice) => {
      try {
        if (choice) localStorage.setItem('theme', choice);
        else localStorage.removeItem('theme');
      } catch {}
      if (choice) root.setAttribute('data-theme', choice);
      else root.removeAttribute('data-theme');
      describe();
    };

    describe();

    const btn = document.getElementById('theme-toggle');
    let held = false;
    let timer = 0;

    const hold = () => {
      timer = window.setTimeout(() => {
        held = true;
        set(null); // back to following the OS
      }, 550);
    };

    const release = () => {
      clearTimeout(timer);
    };

    btn?.addEventListener('pointerdown', hold);
    btn?.addEventListener('pointerup', release);
    btn?.addEventListener('pointerleave', release);
    btn?.addEventListener('pointercancel', release);

    btn?.addEventListener('click', () => {
      if (held) {
        held = false; // the hold already handled it
        return;
      }
      set(active() === 'dark' ? 'light' : 'dark');
    });

    btn?.addEventListener('dblclick', () => set(null));

    // Keyboard: Enter/Space toggles, Escape resets to Auto.
    btn?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && stored()) {
        e.preventDefault();
        set(null);
      }
    });

    media.addEventListener('change', () => {
      if (!stored()) describe();
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') describe();
    });
  })();
</script>
