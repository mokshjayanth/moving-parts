---
// Two states: light and dark. With nothing stored we follow the system
// setting, so the first click always flips away from what is on screen.
// Once clicked the choice is explicit and persists.
---

<button id="theme-toggle" type="button" role="switch" aria-label="Dark mode">
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none"
         stroke="currentColor" stroke-width="1.6"
         stroke-linecap="round" data-icon="sun">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.1M12 19.3v2.1M4.3 4.3l1.5 1.5M18.2 18.2l1.5 1.5M2.6 12h2.1M19.3 12h2.1M4.3 19.7l1.5-1.5M18.2 5.8l1.5-1.5" />
    </svg>
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none"
         stroke="currentColor" stroke-width="1.6"
         stroke-linecap="round" stroke-linejoin="round" data-icon="moon">
      <path d="M20.5 14.2A8.4 8.4 0 1 1 9.8 3.5a6.6 6.6 0 0 0 10.7 10.7Z" />
    </svg>
  </span>
  <span data-theme-label>Dark</span>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    cursor: pointer;
  }

  button:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
  }

  /* Both icons occupy one cell; only the relevant one is shown. */
  .icon svg {
    grid-area: 1 / 1;
    display: none;
  }

  [data-icon='moon'] { display: block; }

  :global(:root[data-theme='dark']) [data-icon='moon'] { display: none; }
  :global(:root[data-theme='dark']) [data-icon='sun'] { display: block; }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) [data-icon='moon'] { display: none; }
    :global(:root:not([data-theme='light'])) [data-icon='sun'] { display: block; }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const stored = () => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : null;
      } catch {
        return null;
      }
    };

    // What is actually on screen right now.
    const active = () => stored() ?? (media.matches ? 'dark' : 'light');

    const sync = () => {
      const next = active() === 'dark' ? 'light' : 'dark';
      const btn = document.getElementById('theme-toggle');
      const label = document.querySelector('[data-theme-label]');
      if (label) label.textContent = next === 'dark' ? 'Dark' : 'Light';
      if (btn) {
        btn.setAttribute('aria-checked', String(active() === 'dark'));
        btn.title = `Switch to ${next} mode`;
      }
    };

    sync();

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = active() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });

    // Follow the OS while the user has not made an explicit choice.
    media.addEventListener('change', () => {
      if (!stored()) sync();
    });
  })();
</script>
