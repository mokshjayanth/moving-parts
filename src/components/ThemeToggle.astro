---
/**
 * Theme control: cycles Auto → Light → Dark.
 *
 * Three states, not two, so the site can always be handed back to the
 * OS setting — a two-state toggle locks you out of Auto on first tap.
 * One button rather than three keeps it to a single tap target, which
 * matters at phone width where the header already wraps.
 *
 * The icon shows the state that is currently in force; the accessible
 * name says so in words, and announces what a tap will do.
 */
---

<button id="theme-toggle" type="button">
  <span class="icon" aria-hidden="true">
    <!-- auto: a dial, half filled -->
    <svg viewBox="0 0 24 24" width="16" height="16" data-icon="auto">
      <circle cx="12" cy="12" r="8.4" fill="none" stroke="currentColor"
              stroke-width="1.6" />
      <path d="M12 3.6a8.4 8.4 0 0 0 0 16.8Z" fill="currentColor" />
    </svg>

    <!-- light: sun -->
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
         stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
         data-icon="light">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.6v2.1M12 19.3v2.1M4.3 4.3l1.5 1.5M18.2 18.2l1.5 1.5M2.6 12h2.1M19.3 12h2.1M4.3 19.7l1.5-1.5M18.2 5.8l1.5-1.5" />
    </svg>

    <!-- dark: moon -->
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
         stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
         stroke-linejoin="round" data-icon="dark">
      <path d="M20.5 14.2A8.4 8.4 0 1 1 9.8 3.5a6.6 6.6 0 0 0 10.7 10.7Z" />
    </svg>
  </span>
</button>

<style>
  button {
    display: inline-grid;
    place-items: center;
    /* 44px tap target, per the usual mobile minimum. */
    inline-size: 2.75rem;
    block-size: 2.75rem;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
  }

  button:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .icon {
    display: grid;
    place-items: center;
    inline-size: 16px;
    block-size: 16px;
  }

  /* All three glyphs share one cell; the state picks which shows. */
  .icon svg {
    grid-area: 1 / 1;
    display: none;
  }

  :global(:root[data-theme-choice='auto']) [data-icon='auto'],
  :global(:root[data-theme-choice='light']) [data-icon='light'],
  :global(:root[data-theme-choice='dark']) [data-icon='dark'] {
    display: block;
  }

  /* Before the script runs, show the auto glyph rather than nothing. */
  :global(:root:not([data-theme-choice])) [data-icon='auto'] {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const order = ['auto', 'light', 'dark'];
    const says = {
      auto: 'Theme: following system. Switch to light.',
      light: 'Theme: light. Switch to dark.',
      dark: 'Theme: dark. Switch to system.',
    };

    const read = () => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : 'auto';
      } catch {
        return 'auto';
      }
    };

    const apply = (choice) => {
      if (choice === 'auto') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', choice);
      root.setAttribute('data-theme-choice', choice);

      const btn = document.getElementById('theme-toggle');
      if (btn) {
        btn.setAttribute('aria-label', says[choice]);
        btn.title = says[choice];
      }
    };

    apply(read());

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = order[(order.indexOf(read()) + 1) % order.length];
      try {
        if (next === 'auto') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {}
      apply(next);
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') apply(read());
    });
  })();
</script>
