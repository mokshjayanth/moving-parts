---
/**
 * Theme toggle: light ⇄ dark.
 *
 * Auto is the default and needs no control: a visitor who never touches
 * this keeps their system setting. Tapping stores an explicit override,
 * which is then permanent — deliberately, since UI to un-choose costs
 * every visitor something to serve almost none.
 */
---

<button id="theme-toggle" type="button">
  <span class="icon" aria-hidden="true">
    <!-- Sun: filled disc with filled rays, so the colour actually reads. -->
    <svg viewBox="0 0 24 24" width="17" height="17" data-icon="light">
      <circle cx="12" cy="12" r="5" fill="currentColor" />
      <g fill="currentColor">
        <rect x="11.1" y="1.4" width="1.8" height="4" rx="0.9" />
        <rect x="11.1" y="18.6" width="1.8" height="4" rx="0.9" />
        <rect x="1.4" y="11.1" width="4" height="1.8" rx="0.9" />
        <rect x="18.6" y="11.1" width="4" height="1.8" rx="0.9" />
        <rect x="11.1" y="1.4" width="1.8" height="4" rx="0.9"
              transform="rotate(45 12 12)" />
        <rect x="11.1" y="18.6" width="1.8" height="4" rx="0.9"
              transform="rotate(45 12 12)" />
        <rect x="1.4" y="11.1" width="4" height="1.8" rx="0.9"
              transform="rotate(45 12 12)" />
        <rect x="18.6" y="11.1" width="4" height="1.8" rx="0.9"
              transform="rotate(45 12 12)" />
      </g>
    </svg>

    <!-- Moon: a filled crescent, for the same reason. -->
    <svg viewBox="0 0 24 24" width="17" height="17" data-icon="dark">
      <path
        d="M21 14.1A8.6 8.6 0 1 1 9.9 3a6.8 6.8 0 0 0 11.1 11.1Z"
        fill="currentColor"
      />
    </svg>
  </span>
</button>

<style>
  button {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    /* A soft fill rather than an outline: still clearly a 44px target,
       but it stops competing with the nav beside it. */
    background: var(--bg-subtle);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.14s;
  }

  button:hover {
    background: color-mix(in srgb, var(--text) 9%, transparent);
  }

  .icon {
    display: grid;
    place-items: center;
    inline-size: 17px;
    block-size: 17px;
  }

  /* Both glyphs share one grid cell. Which one shows is decided by
     the theme, so every rule below is scoped to a theme state rather
     than relying on source order to beat a bare `display: none`. */
  .icon svg {
    grid-area: 1 / 1;
  }

  [data-icon='light'] {
    color: var(--sun);
  }

  [data-icon='dark'] {
    color: var(--moon);
  }

  /* Light is in force unless something says otherwise. */
  [data-icon='dark'] {
    display: none;
  }

  [data-icon='light'] {
    display: block;
  }

  /* System dark, with no explicit override. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) [data-icon='light'] {
      display: none;
    }

    :global(:root:not([data-theme='light'])) [data-icon='dark'] {
      display: block;
    }
  }

  /* Explicit choices always win over the two rules above. */
  :global(:root[data-theme='light']) [data-icon='light'] { display: block; }
  :global(:root[data-theme='light']) [data-icon='dark'] { display: none; }
  :global(:root[data-theme='dark']) [data-icon='light'] { display: none; }
  :global(:root[data-theme='dark']) [data-icon='dark'] { display: block; }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const media = window.matchMedia('(prefers-color-scheme: dark)');

    const stored = () => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : null;
      } catch {
        return null;
      }
    };

    /** What is rendered right now, stored choice or OS. */
    const active = () => stored() ?? (media.matches ? 'dark' : 'light');

    const refresh = () => {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      const to = active() === 'dark' ? 'light' : 'dark';
      btn.setAttribute('aria-label', `Switch to ${to} mode`);
      btn.title = `Switch to ${to} mode`;
    };

    refresh();

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = active() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {}
      root.setAttribute('data-theme', next);
      refresh();
    });

    media.addEventListener('change', refresh);
    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') refresh();
    });
  })();
</script>
