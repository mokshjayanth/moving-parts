---
/**
 * Theme control: Auto, Light, Dark.
 *
 * Auto is the default and follows the OS. Picking Light or Dark stores
 * an explicit override; picking Auto clears it, so the site can always
 * be handed back to the system setting.
 *
 * Rendered as a radiogroup rather than a switch: three states, each
 * with a stable name, which is what assistive tech expects.
 */

const options = [
  { value: 'auto', label: 'Auto' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
];
---

<div class="theme" role="radiogroup" aria-label="Colour theme">
  {options.map((o) => (
    <button
      type="button"
      role="radio"
      aria-checked="false"
      data-theme-choice={o.value}
    >
      {o.label}
    </button>
  ))}
</div>

<style>
  .theme {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.15rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--step--1);
  }

  button {
    font: inherit;
    color: var(--text-muted);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
    transition: color 0.12s, background-color 0.12s;
  }

  button:hover {
    color: var(--text);
  }

  button[aria-checked='true'] {
    color: var(--bg);
    background: var(--text);
  }

  /* The group owns the focus ring; the buttons sit inside it. */
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition: none;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const valid = ['auto', 'light', 'dark'];

    const read = () => {
      try {
        const v = localStorage.getItem('theme');
        return v === 'light' || v === 'dark' ? v : 'auto';
      } catch {
        return 'auto';
      }
    };

    const apply = (choice) => {
      if (choice === 'auto') root.removeAttribute('data-theme');
      else root.setAttribute('data-theme', choice);

      document.querySelectorAll('[data-theme-choice]').forEach((btn) => {
        const on = btn.dataset.themeChoice === choice;
        btn.setAttribute('aria-checked', String(on));
        // Only the active option is a tab stop, per radiogroup convention.
        btn.tabIndex = on ? 0 : -1;
      });
    };

    const store = (choice) => {
      try {
        if (choice === 'auto') localStorage.removeItem('theme');
        else localStorage.setItem('theme', choice);
      } catch {}
    };

    apply(read());

    const buttons = [...document.querySelectorAll('[data-theme-choice]')];

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        const choice = btn.dataset.themeChoice;
        store(choice);
        apply(choice);
      });

      // Arrow keys move between options, as a radiogroup should.
      btn.addEventListener('keydown', (e) => {
        const step =
          e.key === 'ArrowRight' || e.key === 'ArrowDown'
            ? 1
            : e.key === 'ArrowLeft' || e.key === 'ArrowUp'
              ? -1
              : 0;
        if (!step) return;
        e.preventDefault();
        const next = buttons[(i + step + buttons.length) % buttons.length];
        const choice = next.dataset.themeChoice;
        store(choice);
        apply(choice);
        next.focus();
      });
    });

    // Keep other tabs in step.
    window.addEventListener('storage', (e) => {
      if (e.key === 'theme') apply(read());
    });
  })();
</script>
