---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const quests = (await getCollection('sidequests', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.started.valueOf() - a.data.started.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---

<Base title="Side Quests — Moving Parts" description="Hobbies in progress.">
  <h1>Side Quests</h1>
  <p class="lede">Things I'm learning, in whatever state they're in.</p>

  {quests.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <ul class="list">
      {quests.map((quest) => (
        <li>
          <a href={`${base}/sidequests/${quest.id}`}>{quest.data.title}</a>
          <p class="meta">
            <span class={`status status--${quest.data.status}`}>
              {quest.data.status}
            </span>
            <span>since {fmt(quest.data.started)}</span>
          </p>
          <p class="desc">{quest.data.description}</p>
        </li>
      ))}
    </ul>
  )}

  <style>
    .lede {
      color: var(--text-muted);
    }

    .list {
      list-style: none;
      padding: 0;
      display: grid;
      gap: 2.5rem;
      margin-block-start: 2.5rem;
    }

    .list > li > a {
      font-family: var(--font-sans);
      font-size: var(--step-1);
      font-weight: 600;
      text-decoration: none;
    }

    .list > li > a:hover {
      text-decoration: underline;
      text-decoration-color: var(--accent);
    }

    .meta {
      margin: 0.25rem 0 0.5rem;
      font-family: var(--font-sans);
      font-size: var(--step--1);
      color: var(--text-muted);
      display: flex;
      gap: 0.6rem;
      align-items: center;
    }

    .status {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.1rem 0.5rem;
      text-transform: lowercase;
    }

    .status--active {
      border-color: var(--accent);
      color: var(--accent);
    }

    .desc {
      margin: 0;
      color: var(--text-muted);
    }

    .empty {
      color: var(--text-muted);
    }
  </style>
</Base>
