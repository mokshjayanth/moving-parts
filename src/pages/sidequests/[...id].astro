---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const quests = await getCollection('sidequests');
  return quests.map((quest) => ({
    params: { id: quest.id },
    props: { quest },
  }));
}

const { quest } = Astro.props;
const { Content } = await render(quest);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
---

<Base title={`${quest.data.title} — Moving Parts`} description={quest.data.description}>
  <article>
    <header class="head">
      <h1>{quest.data.title}</h1>
      <p class="meta">
        <span class="status">{quest.data.status}</span>
        <span>since {fmt(quest.data.started)}</span>
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <style>
    .head {
      margin-block-end: 2.5rem;
    }

    .meta {
      font-family: var(--font-sans);
      font-size: var(--step--1);
      color: var(--text-muted);
      display: flex;
      gap: 0.75rem;
      align-items: center;
    }

    .status {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.1rem 0.5rem;
    }

    .prose :global(h2) {
      margin-block: 2.5rem 0.75rem;
    }
  </style>
</Base>
