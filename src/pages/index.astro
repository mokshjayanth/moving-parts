---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Moving Parts" backdrop="full" home>
  {/* The wordmark is in the header, so this opens with the statement
      rather than repeating the title. */}
  <h1>
    Notes on how things work — essays, what I'm reading, and hobbies in
    progress.
  </h1>

  <p class="bio">
    <!-- Replace this with your actual bio. -->
    I'm Moksh. I'm interested in the physics of things: taking systems apart
    to understand what makes them go, and writing up what I find.
  </p>

  <nav class="ways" aria-label="Sections">
    <a href={`${base}/essays`}>
      <span class="what">Essays</span>
      <span class="why">Infrequent, considered.</span>
    </a>
    <a href={`${base}/reads`}>
      <span class="what">Reads</span>
      <span class="why">A short shelf, kept honest.</span>
    </a>
    <a href={`${base}/sidequests`}>
      <span class="what">Side Quests</span>
      <span class="why">Things in progress.</span>
    </a>
  </nav>

  <h2 class="section-heading">Elsewhere</h2>
  <ul class="link-row">
    {site.links.map((link) => (
      <li><a href={link.href} rel="me noopener">{link.label}</a></li>
    ))}
  </ul>

  <style>
    /* The opening statement, set as the page's heading. Serif at a
       readable size rather than a display shout. */
    h1 {
      font-size: var(--step-2);
      line-height: 1.3;
      font-weight: 400;
      letter-spacing: -0.005em;
      text-wrap: pretty;
      margin-block: 0 1.5rem;
      max-width: 26rem;
    }

    .bio {
      color: var(--text-muted);
      text-wrap: pretty;
    }

    .ways {
      display: grid;
      gap: 0.1rem;
      margin-block: 3rem;
      border-block-start: 1px solid var(--border);
    }

    .ways a {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
      padding-block: 0.85rem;
      border-block-end: 1px solid var(--border);
      text-decoration: none;
    }

    .what {
      font-weight: 600;
      min-inline-size: 7rem;
    }

    .why {
      font-family: var(--font-sans);
      font-size: var(--step--1);
      color: var(--text-muted);
    }

    .ways a:hover .what {
      color: var(--accent);
    }

    .link-row {
      margin-block-start: 1rem;
    }
  </style>
</Base>
