---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title="Moving Parts" backdrop="full">
  <h1>Moving Parts</h1>

  <p class="lede">Field notes from taking things apart.</p>

  <p>
    <!-- Replace this with your actual bio. -->
    I'm Moksh. I'm interested in the physics of things: taking systems apart
    to understand what makes them go, and writing up what I find.
  </p>

  <h2 class="section-heading">Elsewhere</h2>
  <ul class="link-row">
    {site.links.map((link) => (
      <li><a href={link.href} rel="me noopener">{link.label}</a></li>
    ))}
  </ul>

  <style>
    .lede {
      font-size: var(--step-1);
      line-height: 1.5;
    }

    .link-row {
      margin-block-start: 1rem;
    }
  </style>
</Base>
