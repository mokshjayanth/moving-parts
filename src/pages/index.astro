---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title="Moving Parts" backdrop="full">
  <h1>Moving Parts</h1>

  <p class="lede">
    Notes on how things work — essays, what I'm reading, and hobbies in
    progress.
  </p>

  <p>
    <!-- Replace this with your actual bio. -->
    I'm Moksh. I'm interested in the physics of things: taking systems apart
    to understand what makes them go, and writing up what I find.
  </p>

  <h2>Elsewhere</h2>
  <ul class="links">
    {site.links.map((link) => (
      <li><a href={link.href} rel="me noopener">{link.label}</a></li>
    ))}
  </ul>

  <style>
    .lede {
      font-size: var(--step-1);
      color: var(--text-muted);
      line-height: 1.5;
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      gap: 1.1rem;
      list-style: none;
      padding: 0;
      font-family: var(--font-sans);
      font-size: var(--step--1);
    }
  </style>
</Base>
